{
  "name": "mini-supports",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/package-source.mjs public && vite --host 127.0.0.1",
    "setup:runtime": "node scripts/setup-runtime.mjs",
    "build": "npm run setup:runtime && tsc --noEmit && vite build && node scripts/package-source.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:import && node --experimental-strip-types scripts/test-engine.mjs && npm run test:plate && npm run test:drag && npm run test:raft-split",
    "test:import": "node --experimental-strip-types scripts/test-import.mjs",
    "test:plate": "node --experimental-strip-types scripts/test-plate.mjs",
    "test:drag": "node --experimental-strip-types scripts/test-drag.mjs",
    "test:raft-split": "node scripts/test-raft-split.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "fflate": "0.8.3",
    "lucide": "0.468.0",
    "manifold-3d": "3.5.4",
    "meshoptimizer": "^1.3.0",
    "pyodide": "0.29.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
